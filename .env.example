FLASK_CONFIG=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://ar_drips_user:change-me@localhost:3306/ar_drips
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
UPLOAD_DIR=instance/uploads
MAX_CONTENT_LENGTH=8388608
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Public HTTPS website URL used in owner alert links (no trailing slash).
PUBLIC_BASE_URL=
ORDER_ALERT_EMAIL=
ORDER_ALERT_WHATSAPP=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Meta WhatsApp Cloud API; use a supported version from your Meta dashboard.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Dedicated admin session expiry, in seconds (30 minute idle / 8 hour maximum).
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_MAX_SECONDS=28800

# Optional Docker only. Use new strong passwords; URL-encode the password in the URL.
# Connect to the Compose service named db, not localhost:
# DOCKER_DATABASE_URL=mysql+pymysql://ar_drips_user:URL_ENCODED_PASSWORD@db:3306/ar_drips
DOCKER_DATABASE_URL=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Business inbox for product interest notifications (uses existing MAIL_* SMTP settings).
INTEREST_NOTIFICATION_EMAIL=
